# Every variable is documented in docs/env.md.

# Working database. Optional: by default muckrake uses SQLite at data/muckrake.db.
# The docker compose db publishes on host port 5433 and creates both databases:
# MUCKRAKE_DATABASE_URL=postgresql://muckrake:muckrake@localhost:5433/muckrake

# Published (serving) database. Required for release-publish, which refuses to
# run when this is unset or equal to the working database.
# MUCKRAKE_PUBLISHED_DATABASE_URL=sqlite:///data/published.db
# MUCKRAKE_PUBLISHED_DATABASE_URL=postgresql://muckrake:muckrake@localhost:5433/muckrake_published

# Optional local overrides.
# MUCKRAKE_DATA_PATH=data
# MUCKRAKE_ARTIFACT_PATH=data/artifacts
# MUCKRAKE_DATASET_PATHS=datasets
# MUCKRAKE_FTM_SCHEMA_PATHS=ftm_schema_ext
# MUCKRAKE_ENV_FILE=.env
# FTM_MODEL_PATH is configured automatically by muckrake to include local schema extensions.
# Set this only if you want to override that merged model path explicitly.
# FTM_MODEL_PATH=

# LLM entity extraction (ner-extract --extractor llm). The provider prefix is required.
# LLM_MODEL=openrouter:<model> or anthropic:<model>
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# NER_LLM_PROMPT_FILE=
# LOGFIRE_TOKEN=

# Link template for entities in the dedupe review TUI (%s is the entity ID).
# MUCKRAKE_PROFILE_URL=https://example.org/entity/%s

# Minimum interval in seconds between HTTP requests to the same host
# (politeness rate limit; off by default).
# MUCKRAKE_HTTP_MIN_INTERVAL=0.5
